# this is the turtoise + hoare example from
# https://home.cs.colorado.edu/~srirams/papers/cav2013-martingales.pdf
# page 12

# syntactic changes (to fit loop guard)
# "unspecified" initial money
# draws happen before ifs - otherwise normalization fails

k = 0
money = money0
while money >= 10:
    k = k+1
    bet = Uniform(5,10)
    money = money - bet

    not_green = Bernoulli(36/37)
    is_red = Bernoulli(1/2)
    is_column_one = Bernoulli(1/3)
    is_column_two = Bernoulli(1/2)

    if not_green == 1:
        if is_column_one == 1:
            if is_red == 1:
                money = money + bet*1.6
            else:
                money = money + bet*1.2
            end
        else:
            if is_column_two == 1:
                if is_red == 1:
                    money = money + 1.6*bet
                else:
                    money = money + 1.2*bet
                end
            else:
                if is_red == 1:
                    money = money + 0.4*bet
                end
            end
        end
    end
end
