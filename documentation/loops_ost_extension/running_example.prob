x = x0
y = y0
z = z0

u = u0
n1 = n10
n2 = n20
k = 0
while x>0:
    k = k + 1
    u = Uniform(-1, 0)
    x = x + u
    n1 = Normal(1,2)
    y = y + n1 + u
    n2 = Normal(-2,4)
    z = z + y + n2
end


