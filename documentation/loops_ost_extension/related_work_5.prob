# Listing 1.4 from https://arxiv.org/pdf/1811.06779
# this is basically the same as the running example, but with fixed value for x0
# this also occures in https://dl.acm.org/doi/pdf/10.1145/3453483.3454062


z= z0
x = 2

k = 0
while x>0:
    k = k + 1
    c = Bernoulli(7/10)
    if c == 1:
        z = Uniform(0,1)
        x = x - z
    else:
        z = Uniform(0,1)
        x = x + z
    end
end

